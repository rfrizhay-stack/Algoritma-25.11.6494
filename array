#include <iostream>
#include <string>

using namespace std;

int main() {
    string idBarang[50];
    string namaBarang[50];
    int jumlahBarang[50];
    int jumlahData = 0;
    int pilihan;

    do {
        cout << "\n=== MENU INVENTARIS BARANG 25.11.6501 ===" << endl;
        cout << "1. View Data" << endl;
        cout << "2. Input Data" << endl;
        cout << "3. Exit" << endl;
        cout << "Pilih menu: ";
        cin >> pilihan;

        if (pilihan == 1) { 
            cout << "\nData Inventaris:" << endl;
            if (jumlahData == 0) {
                cout << "Data kosong." << endl;
            }
            else {
                for (int i = 0; i < jumlahData; i++) {
                    cout << i + 1 << ". ID: " << idBarang[i]
                        << " | Nama: " << namaBarang[i]
                        << " | Jumlah: " << jumlahBarang[i] << endl;
                }
            }
        }
        else if (pilihan == 2) { 
            if (jumlahData < 50) {
                cout << "\nInput Data ke-" << jumlahData + 1 << endl;
                cout << "ID Barang: "; cin >> idBarang[jumlahData];
                cout << "Nama Barang: "; cin.ignore(); getline(cin, namaBarang[jumlahData]);
                cout << "Jumlah Barang: "; cin >> jumlahBarang[jumlahData];
                jumlahData++;
            }
            else {
                cout << "Penyimpanan penuh!" << endl;
            }
        }
    } while (pilihan != 3); 

    return 0;
}
